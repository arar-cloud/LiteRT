# Bazel version management configuration
# Last updated: 2025

# Pin Bazel version to ensure consistent builds across all platforms
# Supports backend, mobile, web, and Python targets
USE_BAZEL_VERSION=7.0.0

# Build configuration flags
BUILD_OPTS="--announce_rc"

# Platform-specific flags
if [ -z "$BAZEL_ANDROID_TOOLS_VERSIONS" ]; then
  export BAZEL_ANDROID_TOOLS_VERSIONS="ndk=27.1.12297006"
fi

# Cache configuration for faster rebuilds
if [ -z "$BAZEL_CACHE_DIR" ]; then
  export BAZEL_CACHE_DIR="$HOME/.cache/bazel"
fi
